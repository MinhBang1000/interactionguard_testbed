# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Required ---
OPENAI_API_KEY=
MODE=1

# --- Data root (override to relocate the whole data/ tree) ---
# DATA_ROOT=./data
# RAW_DIR=./data/raw
# RAW_NQ_DIR=./data/raw/nq
# CORPORA_DIR=./data/corpora
# VECTORSTORE_DIR=./data/vectorstore
# SEED_DIR=./data/seed
# PROMPTS_DIR=./data/prompts
# TRACES_DIR=./data/traces
# PROCESSED_DIR=./data/processed
# UPLOADS_DIR=./uploads

# --- Secrets / Gmail OAuth (never commit) ---
# CREDENTIALS_PATH=./credentials.json
# TOKEN_PATH=./token.pkl

# --- Models (defaults match the original hardcoded values) ---
# AGENT_MODEL=gpt-4o-mini
# AGENT_TEMPERATURE=0.6
# GEN_MODEL_DEFAULT=gpt-4o-mini
# GEN_MODEL_TOOL_INJECTION=gpt-4o
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Data-generation constants (defaults match the original hardcoded values) ---
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# DATA_SEED=42
# POISON_SAMPLE_SIZE=100
# POISON_TOPK_RETRIEVE=6
